{
  "preset": "@amazon-devices/react-native-kepler",
  "testRegex": "/test/.*\\.(test|spec)\\.(ts|tsx|js)$",
  "moduleFileExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json",
    "node"
  ],
  "moduleNameMapper": {
    "^react-native$": "@amazon-devices/react-native-kepler",
    "^react-native/(.*)$": "@amazon-devices/react-native-kepler/$1",
    "^~/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/setup.tsx", "<rootDir>/test/jestSetup.js"],
  "modulePaths": ["<rootDir>/src"],
  "roots": [
    "<rootDir>/src/",
    "<rootDir>/test/",
    "<rootDir>/node_modules/"
  ],
  "transformIgnorePatterns": [
    "node_modules/(?!(react-native|@react-native|@amazon-devices/react-native-kepler|@amazon-devices|@jellyfin/sdk|axios)/)"
  ],
  "collectCoverage": false,
  "collectCoverageFrom": [
    "src/**/*",
    "!**/index.{ts,js,tsx}",
    "!**/types.ts",
    "!src/**/*.d.ts"
  ],
  "coverageDirectory": ".tmp/coverage"
}
